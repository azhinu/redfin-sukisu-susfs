diff --git a/kernel/susfs.c b/kernel/susfs.c
new file mode 100644
--- /dev/null
+++ b/kernel/susfs.c
@@ -0,0 +1,21 @@
+#include <linux/susfs.h>
+#include <linux/uaccess.h>
+
+/*
+ * SukiSU v4.2 ksud sends SUSFS commands through reboot(2).  The legacy
+ * KSU reboot transport uses a different second magic value, so this handler
+ * is called explicitly from the kernel reboot syscall callsite.
+ */
+int ksu_handle_susfs_reboot(int magic1, int magic2, unsigned int cmd,
+			    void __user *arg)
+{
+#ifdef CONFIG_KSU_SUSFS
+	return susfs_handle_reboot(magic1, magic2, cmd, arg);
+#else
+	(void)magic1;
+	(void)magic2;
+	(void)cmd;
+	(void)arg;
+	return 0;
+#endif
+}
