+/* Serialize KernelSU policy edits; SELinux's policy_rwlock is a spinlock. */
+static DEFINE_MUTEX(ksu_legacy_policy_mutex);
+
+static struct selinux_policy *ksu_legacy_policy_snapshot(void)
+{
+	struct selinux_policy *policy;
+	struct policy_file fp;
+	void *data = NULL;
+	size_t len = 0;
+	int ret;
+
+	ret = security_read_policy(&selinux_state, &data, &len);
+	if (ret)
+		goto out_error;
+
+	policy = kzalloc(sizeof(*policy), GFP_KERNEL);
+	if (!policy) {
+		ret = -ENOMEM;
+		goto out_error;
+	}
+
+	fp.data = data;
+	fp.len = len;
+	ret = policydb_read(&policy->policydb, &fp);
+	if (ret) {
+		policydb_destroy(&policy->policydb);
+		kfree(policy);
+		goto out_error;
+	}
+	policy->policydb.len = len;
+	read_lock(&selinux_state.ss->policy_rwlock);
+	policy->latest_granting = selinux_state.ss->latest_granting;
+	policy->policydb.android_netlink_route =
+		selinux_state.ss->policydb.android_netlink_route;
+	policy->policydb.android_netlink_getneigh =
+		selinux_state.ss->policydb.android_netlink_getneigh;
+	read_unlock(&selinux_state.ss->policy_rwlock);
+	vfree(data);
+	return policy;
+
+out_error:
+	vfree(data);
+	return ERR_PTR(ret);
+}
+
+/* security_load_policy performs SID conversion, a short atomic swap, and AVC reset. */
+static int ksu_legacy_policy_commit(struct selinux_policy *policy)
+{
+	size_t size = policy->policydb.len + SZ_1M;
+	int ret;
+
+	while (size <= 64 * SZ_1M) {
+		struct policy_file fp;
+		void *data = vmalloc(size);
+
+		if (!data)
+			return -ENOMEM;
+		fp.data = data;
+		fp.len = size;
+		ret = policydb_write(&policy->policydb, &fp);
+		if (!ret) {
+			/* This 4.19 writer omits Android's netlink policy config bits. */
+			u32 *config = (u32 *)((u8 *)data + 20);
+			if (policy->policydb.android_netlink_route)
+				*config |=
+					POLICYDB_CONFIG_ANDROID_NETLINK_ROUTE;
+			if (policy->policydb.android_netlink_getneigh)
+				*config |=
+					POLICYDB_CONFIG_ANDROID_NETLINK_GETNEIGH;
+			ret = security_load_policy(&selinux_state, data,
+						   size - fp.len);
+			vfree(data);
+			return ret;
+		}
+		vfree(data);
+		if (ret != -EINVAL)
+			return ret;
+		size *= 2;
+	}
+	return -E2BIG;
+}
+#endif
