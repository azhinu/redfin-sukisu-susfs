+/*
+ * Narrow kernel-side mount helper for SukiSU's namespace setup.  The 4.19
+ * tree predates path_mount(); only propagation changes are accepted here.
+ */
+int ksu_path_mount(const char *dev_name, struct path *path,
+		   const char *type_page, unsigned long flags, void *data_page)
+{
+	int ret;
+
+	if (dev_name || type_page || data_page)
+		return -EINVAL;
+	if (flags & MS_NOUSER)
+		return -EINVAL;
+	ret = security_sb_mount(NULL, path, NULL, flags, NULL);
+	if (ret)
+		return ret;
+	if (!may_mount())
+		return -EPERM;
+	return do_change_type(path, flags);
+}
+EXPORT_SYMBOL_GPL(ksu_path_mount);
 
