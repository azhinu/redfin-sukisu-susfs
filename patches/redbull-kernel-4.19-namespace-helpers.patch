+/*
+ * Kernel-side mount teardown for callers that already resolved a path.
+ * Linux 4.19 has no path_umount() helper; keep the same reference and
+ * mount-point checks used by the later upstream helper.
+ */
+int ksu_path_umount(struct path *path, int flags)
+{
+	struct mount *mnt = real_mount(path->mnt);
+	int ret;
+
+	if (flags & ~(MNT_FORCE | MNT_DETACH | MNT_EXPIRE | UMOUNT_NOFOLLOW))
+		ret = -EINVAL;
+	else if (!may_mount())
+		ret = -EPERM;
+	else if (path->dentry != path->mnt->mnt_root)
+		ret = -EINVAL;
+	else if (!check_mnt(mnt))
+		ret = -EINVAL;
+	else if (mnt->mnt.mnt_flags & MNT_LOCKED)
+		ret = -EINVAL;
+	else if ((flags & MNT_FORCE) && !capable(CAP_SYS_ADMIN))
+		ret = -EPERM;
+	else
+		ret = do_umount(mnt, flags);
+
+	/* The caller passed ownership of both references to this helper. */
+	dput(path->dentry);
+	mntput_no_expire(mnt);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(ksu_path_umount);
 
