+static bool ksu_manual_execve_ready;
+
+void ksu_manual_execveat_enable(void)
+{
+	WRITE_ONCE(ksu_manual_execve_ready, true);
+}
+
+void ksu_manual_execveat(const char *path,
+			 const char __user *const __user *argv_user)
+{
+	struct user_arg_ptr argv = {.ptr.native = argv_user};
+	char path_copy[32];
+
+	if (!READ_ONCE(ksu_manual_execve_ready) || !path)
+		return;
+	if (strscpy(path_copy, path, sizeof(path_copy)) < 0)
+		return;
+	if (strncmp(path_copy, "/system/bin/app_process",
+		    sizeof("/system/bin/app_process") - 1) != 0)
+		return;
+	ksu_handle_execveat_ksud(path_copy, &argv);
+}
