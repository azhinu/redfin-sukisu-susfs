diff --git a/kernel/susfs_v155.h b/kernel/susfs_v155.h
new file mode 100644
--- /dev/null
+++ b/kernel/susfs_v155.h
@@ -0,0 +1,20 @@
+#ifndef __KSU_SUSFS_V155_H
+#define __KSU_SUSFS_V155_H
+
+#include <linux/sched.h>
+
+/* SUSFS v1.5.5 userspace submits commands through prctl(2). */
+#define KSU_SUSFS_PRCTL_OPTION 0xDEADBEEF
+
+static inline bool ksu_susfs_is_current_proc_umounted(void)
+{
+	return !!(current->susfs_task_state &
+		  TASK_STRUCT_NON_ROOT_USER_APP_PROC);
+}
+
+static inline void ksu_susfs_set_current_proc_umounted(void)
+{
+	current->susfs_task_state |= TASK_STRUCT_NON_ROOT_USER_APP_PROC;
+}
+
+#endif
