 #include "supercalls.h"
@@ -58,6 +59,135 @@
 {
 	return current_uid().val == 0;
 }
+
+#ifdef CONFIG_KSU_SUSFS
+static int ksu_susfs_reply(unsigned long error_pointer, int result)
+{
+	if (!error_pointer)
+		return -EFAULT;
+
+	return put_user(result, (int __user *)error_pointer) ? -EFAULT : 0;
+}
+
+static int ksu_susfs_copy_reply(unsigned long data, const void *source,
+				size_t size, unsigned long error_pointer)
+{
+	int result;
+
+	if (!data)
+		return -EFAULT;
+
+	result = copy_to_user((void __user *)data, source, size) ? -EFAULT : 0;
+	return ksu_susfs_reply(error_pointer, result);
+}
+
+int ksu_handle_susfs_prctl(int option, unsigned long command,
+			   unsigned long data, unsigned long error_pointer)
+{
+	int result = -1;
+
+	if (option != KSU_SUSFS_PRCTL_OPTION)
+		return -ENOSYS;
+	if (current_uid().val != 0)
+		return -EPERM;
+	if (!error_pointer || put_user(-1, (int __user *)error_pointer))
+		return -EFAULT;
+
+	switch (command) {
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+	case CMD_SUSFS_ADD_SUS_PATH:
+		result = susfs_add_sus_path(
+			(struct st_susfs_sus_path __user *)data);
+		break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+	case CMD_SUSFS_ADD_SUS_MOUNT:
+		result = susfs_add_sus_mount(
+			(struct st_susfs_sus_mount __user *)data);
+		break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+	case CMD_SUSFS_ADD_SUS_KSTAT:
+	case CMD_SUSFS_ADD_SUS_KSTAT_STATICALLY:
+		result = susfs_add_sus_kstat(
+			(struct st_susfs_sus_kstat __user *)data);
+		break;
+	case CMD_SUSFS_UPDATE_SUS_KSTAT:
+		result = susfs_update_sus_kstat(
+			(struct st_susfs_sus_kstat __user *)data);
+		break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
+	case CMD_SUSFS_SET_UNAME:
+		result = susfs_set_uname((struct st_susfs_uname __user *)data);
+		break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
+	case CMD_SUSFS_ENABLE_LOG:
+		if (data == 0 || data == 1) {
+			susfs_set_log(data);
+			result = 0;
+		} else {
+			result = -EINVAL;
+		}
+		break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+	case CMD_SUSFS_SET_CMDLINE_OR_BOOTCONFIG:
+		result = susfs_set_cmdline_or_bootconfig((char __user *)data);
+		break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
+	case CMD_SUSFS_ADD_OPEN_REDIRECT:
+		result = susfs_add_open_redirect(
+			(struct st_susfs_open_redirect __user *)data);
+		break;
+#endif
+	case CMD_SUSFS_SHOW_VERSION:
+		return ksu_susfs_copy_reply(data, SUSFS_VERSION,
+					    sizeof(SUSFS_VERSION),
+					    error_pointer);
+	case CMD_SUSFS_SHOW_VARIANT:
+		return ksu_susfs_copy_reply(data, SUSFS_VARIANT,
+					    sizeof(SUSFS_VARIANT),
+					    error_pointer);
+	case CMD_SUSFS_SHOW_ENABLED_FEATURES: {
+		unsigned long features = 0;
+
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+		features |= BIT(0);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+		features |= BIT(1);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+		features |= BIT(4);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
+		features |= BIT(8);
+#endif
+#ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
+		features |= BIT(9);
+#endif
+#ifdef CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS
+		features |= BIT(10);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+		features |= BIT(11);
+#endif
+#ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
+		features |= BIT(12);
+#endif
+		return ksu_susfs_copy_reply(data, &features, sizeof(features),
+					    error_pointer);
+	}
+	default:
+		break;
+	}
+
+	return ksu_susfs_reply(error_pointer, result);
+}
+#endif
 
