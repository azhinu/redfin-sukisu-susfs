diff --git a/kernel/supercall/supercall.h b/kernel/supercall/supercall.h
--- a/kernel/supercall/supercall.h
+++ b/kernel/supercall/supercall.h
@@ -19,6 +19,10 @@
 // Install KSU fd to current process
 int ksu_install_fd(void);
 
+/* Dispatch the legacy reboot(2) transport from a source callsite. */
+int ksu_handle_sys_reboot(int magic1, int magic2, unsigned int cmd,
+			  void __user *arg);
+
 void ksu_supercalls_init(void);
 void ksu_supercalls_exit(void);
 #endif // __KSU_H_SUPERCALL
diff --git a/kernel/supercall/supercall.c b/kernel/supercall/supercall.c
--- a/kernel/supercall/supercall.c
+++ b/kernel/supercall/supercall.c
@@ -65,6 +65,31 @@
     pr_info("ksu fd installed: %d for pid %d\n", fd, current->pid);
     return fd;
 }
+
+#ifdef CONFIG_KSU_MANUAL_HOOK
+int ksu_handle_sys_reboot(int magic1, int magic2, unsigned int cmd,
+			  void __user *arg)
+{
+	int fd;
+
+	(void)cmd;
+
+	if (magic1 != KSU_INSTALL_MAGIC1 || magic2 != KSU_INSTALL_MAGIC2 ||
+	    !arg)
+		return 0;
+
+	fd = ksu_install_fd();
+	if (fd < 0)
+		return 0;
+
+	if (copy_to_user(arg, &fd, sizeof(fd))) {
+		pr_err("KSU fd reply copy failed\n");
+		ksu_close_fd(fd);
+	}
+
+	return 0;
+}
+#endif
 
 #ifndef CONFIG_KSU_MANUAL_HOOK
 static void ksu_install_fd_tw_func(struct callback_head *cb)
