+static void ksu_allow_reboot_syscall(void)
+{
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 10, 2)
+	ksu_disable_seccomp();
+#else
+	if (current->seccomp.mode == SECCOMP_MODE_FILTER &&
