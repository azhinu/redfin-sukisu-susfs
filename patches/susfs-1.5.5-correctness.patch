+				kfree_rcu(entry, rcu);
+			}
+		}
+	}
+#endif
+	spin_unlock(&susfs_spin_lock);
+}
+
+void susfs_forget_superblock(struct super_block *sb)
+{
+	u64 sb_id;
+
+	if (!sb)
+		return;
+	sb_id = READ_ONCE(sb->s_susfs_id);
+
+	spin_lock(&susfs_spin_lock);
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+	{
+		struct st_susfs_sus_path_hlist *entry;
+		struct hlist_node *tmp_node;
+		int bkt;
+
+		hash_for_each_safe (SUS_PATH_HLIST, bkt, tmp_node, entry,
+				    node) {
+			if (entry->target_sb_id == sb_id) {
+				hash_del_rcu(&entry->node);
+				kfree_rcu(entry, rcu);
+			}
+		}
+	}
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+	{
+		struct st_susfs_sus_kstat_hlist *entry;
+		struct hlist_node *tmp_node;
+		int bkt;
+
+		hash_for_each_safe (SUS_KSTAT_HLIST, bkt, tmp_node, entry,
+				    node) {
+			if (entry->target_sb_id == sb_id) {
+				hash_del_rcu(&entry->node);
+				kfree_rcu(entry, rcu);
+			}
+		}
+	}
+#endif
+#ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
+	{
+		struct st_susfs_open_redirect_hlist *entry;
+		struct hlist_node *tmp_node;
+		int bkt;
+
+		hash_for_each_safe (OPEN_REDIRECT_HLIST, bkt, tmp_node, entry,
+				    node) {
+			if (entry->target_sb_id == sb_id) {
+				hash_del_rcu(&entry->node);
+				kfree_rcu(entry, rcu);
+			}
+		}
+	}
+#endif
+	spin_unlock(&susfs_spin_lock);
+}
+
+void susfs_refresh_inode_markers(struct inode *inode)
+{
+	unsigned long state = 0;
+	unsigned long ino;
+	u64 sb_id;
+
+	if (!inode)
+		return;
+	ino = inode->i_ino;
+	sb_id = READ_ONCE(inode->i_sb->s_susfs_id);
+
+	rcu_read_lock();
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+	{
+		struct st_susfs_sus_path_hlist *entry;
+
+		hash_for_each_possible_rcu (SUS_PATH_HLIST, entry, node, ino) {
+			if (entry->target_ino == ino &&
+			    entry->target_sb_id == sb_id) {
+				state |= INODE_STATE_SUS_PATH;
+				break;
+			}
+		}
+	}
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+	{
+		struct st_susfs_sus_kstat_hlist *entry;
+
+		hash_for_each_possible_rcu (SUS_KSTAT_HLIST, entry, node, ino) {
+			if (entry->target_ino == ino &&
+			    entry->target_sb_id == sb_id) {
+				state |= INODE_STATE_SUS_KSTAT;
+				break;
+			}
+		}
+	}
+#endif
+#ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
+	{
+		struct st_susfs_open_redirect_hlist *entry;
+
+		hash_for_each_possible_rcu (OPEN_REDIRECT_HLIST, entry, node,
+					    ino) {
+			if (entry->target_ino == ino &&
+			    entry->target_sb_id == sb_id) {
+				state |= INODE_STATE_OPEN_REDIRECT;
+				break;
+			}
+		}
+	}
+#endif
+	rcu_read_unlock();
+
+	if (state) {
+		spin_lock(&inode->i_lock);
+		inode->i_state |= state;
+		spin_unlock(&inode->i_lock);
+	}
+}
+#endif
 
