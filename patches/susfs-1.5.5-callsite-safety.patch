diff --git a/fs/namespace.c b/fs/namespace.c
--- a/fs/namespace.c
+++ b/fs/namespace.c
@@ -1402,6 +1402,36 @@
 	return mnt;
 }
 EXPORT_SYMBOL(mntget);
+
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+/* Return a referenced visible ancestor, or -ENOENT for a detached hidden mount. */
+struct vfsmount *susfs_get_visible_mnt(struct vfsmount *mnt, int *mnt_id)
+{
+	struct mount *visible;
+	struct vfsmount *result = ERR_PTR(-ENOENT);
+
+	if (!mnt)
+		return result;
+
+	visible = real_mount(mnt);
+	read_seqlock_excl(&mount_lock);
+	while (visible->mnt_id >= DEFAULT_SUS_MNT_ID) {
+		if (!mnt_has_parent(visible)) {
+			visible = NULL;
+			break;
+		}
+		visible = visible->mnt_parent;
+	}
+	if (visible) {
+		if (mnt_id)
+			*mnt_id = visible->mnt_id;
+		result = mntget(&visible->mnt);
+	}
+	read_sequnlock_excl(&mount_lock);
+
+	return result;
+}
+#endif
 
